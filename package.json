{
  "name": "example-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "type-check": "npx tsc --noEmit -p tsconfig.app.json",
    "steiger": "npx steiger ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "test:ui": "vitest --ui",
    "test:staged": "vitest related --run",
    "test:preview": "vitest-preview",
    "test:coverage": "vitest run --coverage",
    "plop": "plop"
  },
  "dependencies": {
    "@mantine/charts": "^9.1.1",
    "@mantine/colors-generator": "^9.1.1",
    "@mantine/core": "^9.1.1",
    "@mantine/dates": "^9.1.1",
    "@mantine/dropzone": "^9.1.1",
    "@mantine/form": "^9.1.1",
    "@mantine/hooks": "^9.1.1",
    "@mantine/modals": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@remixicon/react": "^4.6.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "axios": "^1.13.5",
    "chroma-js": "^3.1.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.18",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "mantine-datatable": "^8.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^5.0.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.2.0",
    "uuid": "^11.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-istanbul": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild-plugin-react-virtualized": "^1.0.5",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.6",
    "plop": "^4.0.2",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.6.2",
    "steiger": "^0.5.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "7.1.11",
    "vite-plugin-preload": "^0.4.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vitest-sonar-reporter": "^2.0.4"
  },
  "lint-staged": {
    "*.(css|html)": "prettier --write --ignore-unknown",
    "*.(ts|js|tsx|jsx)": [
      "npm run lint:fix"
    ]
  },
  "volta": {
    "node": "22.12.0"
  }
}
